{
  "manifest_version": 3,
  "name": "Arcivo — Personal Internet Archive",
  "version": "1.0.0",
  "description": "Quickly save, organize, and archive web pages and research directly into your Arcivo workspace.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Archive this page to Arcivo"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"]
    }
  ]
}
