# Database (PostgreSQL)
DATABASE_URL="postgresql://arcivo_user:arcivo_password@localhost:5432/arcivo_db?schema=public"

# Application Server
PORT=4000
NODE_ENV="development"

# JWT Authentication
JWT_SECRET="arcivo-super-secret-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="arcivo-refresh-secret-change-in-production-2026"
JWT_REFRESH_EXPIRES_IN="30d"
EXTENSION_TOKEN_EXPIRES_IN="90d"

# Google OAuth (Google Identity Services client ID — https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""

# External API Integrations (Free tiers / keys)
YOUTUBE_API_KEY=""
GEMINI_API_KEY=""

# Client Origin (CORS)
CLIENT_URL="http://localhost:5173"

